# 开放签本地部署凭据与端口（复制为 .env 后按需修改；.env 不纳入 git）
#
# 安全要求：
#   * 所有口令不得使用示例/弱口令；首次部署由 up.sh 自动生成随机值并把 .env 权限收紧为 600。
#   * docker-compose.yml 不再为任何口令提供兜底默认值，缺失或弱口令会直接拒绝启动。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=opensign
REDIS_PASSWORD=
# PowerJob 专用数据库账号（最小权限，不再使用 MySQL root）
POWERJOB_DB_USER=kfq_powerjob
POWERJOB_DB_PASSWORD=

MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
POWERJOB_HOST_PORT=7990
WEB_HOST_PORT=8806

# 系统访问地址（写入 sys_app_info.app_address，签署跳转链接依赖它）
KAIFANGQIAN_APP_ADDRESS=http://localhost:8806

# 本系统管理员账号。
# 密码只在首次初始化（空库导入）时写入；admin 已存在时 up.sh 不会覆盖，界面改过的密码会被保留。
# 需要强制重置为下面的值时执行：./up.sh --reset-admin-password
KAIFANGQIAN_ADMIN_USER=admin
KAIFANGQIAN_ADMIN_PASSWORD=

# 本地签名证书（PFX）口令：由 up.sh 首次部署自动生成并写入本文件，禁止使用弱口令、禁止提交到 git。
# 轮换口令前必须先按部署文档迁移已有证书，否则服务会拒绝启动（不会静默重建 CA）。
KFQ_LOCAL_CA_PASSWORD=

# 本地实名认证短路开关（生产安全默认：false）：
#   false = 走真实实名认证（默认；生产必须保持 false）
#   true  = 实名认证本地短路，不校验真实身份材料
# 仅当明确接受“无真实实名”的本地私有化部署时才可显式置 true；生产/公网环境严禁开启。
SERVICE_LOCAL_AUTH_ENABLED=false

# 短信验证码模式（生产安全默认：随机）：
#   true  = 每次随机 6 位（默认；生产必须同时接入真实短信网关，否则用户收不到）
#   false = 固定调试码（后端 DEFAULTCODE，即 123456），仅供构建调试
# 固定调试码属于不安全模式，必须同时显式设置 KAIFANGQIAN_ALLOW_INSECURE_SMS_DEBUG=true 才会生效。
KAIFANGQIAN_SEND_RANDOM_SMS_CODE=true
KAIFANGQIAN_ALLOW_INSECURE_SMS_DEBUG=false

# OpenAPI 开发者凭据 id；token 由 init-db.sh 随机生成后回写到 .env
KAIFANGQIAN_API_DEVELOPER_ID=kfq-local-poc-dev
KAIFANGQIAN_API_DEVELOPER_NAME="Kaifangqian Local POC"

# 官方 license 授权码（可选）：留空即使用本地默认授权，不依赖官方签发
SERVICE_TOKEN=
